# Local development defaults only. Firebase project config is built into the app.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
BASE_PATH=
# Admin code is initialized to 0706 on first run and can be changed from the hidden admin panel.
PUBLIC_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=0
MAX_UPLOAD_MB=15
STORAGE_DIR=

# Outside Google-hosted runtimes, Firebase Admin credentials must be stored as host secrets.
# Do not put a service-account private key in source control or frontend code.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional Telegram Bot API integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Optional Telegram MTProto account integration.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
