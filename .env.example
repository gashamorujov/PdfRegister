# Local development defaults only. Replace secrets before production deployment.
NODE_ENV=development
# Serverin dinlədiyi host/port. PaaS platformaları adətən PORT dəyərini özləri verir.
HOST=0.0.0.0
PORT=3000
# Domain kökündə deyil, alt-qovluqda deploy edirsinizsə (məs. https://example.com/docflow) doldurun.
BASE_PATH=
# Production-da boş buraxsanız SESSION_SECRET avtomatik yaradılıb storage-də saxlanılır,
# ADMIN_CODE isə avtomatik yaradılıb server log-una yazılır. Sabit dəyər istəyirsinizsə burada verin.
ADMIN_CODE=0706
SESSION_SECRET=
PUBLIC_ORIGIN=http://localhost:3000
# Comma-separated extra browser origins, only when a separate frontend is used.
ALLOWED_ORIGINS=
# Set to the number of trusted reverse proxies in front of this app (usually 1).
TRUST_PROXY_HOPS=0
MAX_UPLOAD_MB=15
# Optional data path; Docker Compose keeps the default /app/storage on a persistent volume.
STORAGE_DIR=

# Firebase Realtime Database service account (hosting secret manager-də təyin edin).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# Optional Telegram Bot API integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Optional Telegram MTProto account integration.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
